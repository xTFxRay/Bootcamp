{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-response-shape.sh\"",
            "timeout": 15,
            "statusMessage": "Checking API response shape"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-severity-enum.sh\"",
            "timeout": 15,
            "statusMessage": "Checking severity values"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/page_down.sh\"",
            "timeout": 60,
            "statusMessage": "Checking the app is still up after the commit"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/flaky-after-result.sh\"",
            "timeout": 40,
            "statusMessage": "Recomputing flaky tests after the run result"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-flake-hypotheses.sh\"",
            "timeout": 15,
            "statusMessage": "Checking every flaky test has a hypothesis"
          }
        ]
      }
    ]
  }
}
