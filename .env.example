# Copy this file to .env and fill in what you need. .env is git-ignored; never commit it.

# Discord channel webhook for "test case failed" alerts. Leave empty to turn alerts off.
# Discord: channel settings → Integrations → Webhooks → New Webhook → Copy Webhook URL.
DISCORD_WEBHOOK_URL=

# Claude API key for automatic root-cause hypotheses on the Flaky tests page (/flaky).
# Leave empty to turn them off. Get one at https://platform.claude.com (API keys).
# Each hypothesis is one Claude Opus 5.5 request, billed to the key's account.
ANTHROPIC_API_KEY=

# Write token for flaky-test hypotheses (saving, deleting, "Write with AI"). Optional locally;
# set it on the deployed site so strangers can't change them, and keep the same value here so the
# flake-analyst agent can save to that site. Make one with: openssl rand -hex 24
FLAKY_WRITE_TOKEN=

# Public address of the app, used for the link in Discord alerts.
# Optional: defaults to http://localhost:5173, or to the Render address when deployed there.
APP_URL=

# Port for the Express server in local development (the React dev server sends /api here).
# npm run dev sets it to 3001. Leave it unset on hosts such as Render, which set PORT instead.
SERVER_PORT=3001

# Where the SQLite database file is kept. Optional: defaults to server/data/app.db.
DB_PATH=
