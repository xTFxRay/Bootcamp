# Copy this file to .env and fill in what you need. .env is git-ignored; never commit it.

# Discord channel webhook for "test case failed" alerts. Leave empty to turn alerts off.
# Discord: channel settings → Integrations → Webhooks → New Webhook → Copy Webhook URL.
DISCORD_WEBHOOK_URL=

# Public address of the app, used for the link in Discord alerts.
# Optional: defaults to http://localhost:5173, or to the Render address when deployed there.
APP_URL=

# Port for the Express server in local development (the React dev server sends /api here).
# Hosts such as Render set PORT instead, which takes priority.
SERVER_PORT=3001

# Where the SQLite database file is kept. Optional: defaults to server/data/app.db.
DB_PATH=
